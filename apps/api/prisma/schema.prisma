  @@index([userId, createdAt])
  @@map("content_actions")
}

model EventTag {
  eventId String @map("event_id")
  tagId   String @map("tag_id")
  sortOrder Int @default(0) @map("sort_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@index([eventId, sortOrder])
  @@map("event_tags")
}

model UserInterestTag {
  userId    String       @map("user_id")
  tagId     String       @map("tag_id")
  sentiment TagSentiment @default(like)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
  @@map("user_interest_tags")
}

model ProfileTagSuggestion {
  id            String       @id @default(uuid())
  targetUserId  String       @map("target_user_id")
  suggestedById String       @map("suggested_by_id")
  tagId         String       @map("tag_id")
  sentiment     TagSentiment @default(like)
  status        String       @default("pending")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  targetUser  User @relation("ProfileTagSuggestionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  suggestedBy User @relation("ProfileTagSuggestionSender", fields: [suggestedById], references: [id], onDelete: Cascade)
  tag         Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([targetUserId, suggestedById, tagId, status])
  @@index([targetUserId, status, createdAt])
  @@index([suggestedById, status, createdAt])
  @@map("profile_tag_suggestions")
}

model ContentReport {
  id             String           @id @default(uuid())
  targetType     ReportTargetType @map("target_type")
  targetId       String           @map("target_id")
  ruleId         String?          @map("rule_id")
  reason         String
  details        String?
  status         ReportStatus     @default(open)
  resolutionNote String?          @map("resolution_note")
  reporterId     String           @map("reporter_id")
  resolvedById   String?          @map("resolved_by")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  reporter   User        @relation("ReportSubmittedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?       @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  rule       ReportRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([ruleId])
  @@map("content_reports")
}

model ReportGroupNote {
  id          String           @id @default(uuid())
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id")
  note        String
  updatedById String?          @map("updated_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([targetType, targetId])
  @@map("report_group_notes")
}

model ReportGroupComment {
  id          String           @id @default(uuid())
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id")
  body        String
  createdById String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@map("report_group_comments")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  type       String
  title      String
  body       String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String    @id @default(uuid())
  notificationId String    @map("notification_id")
  userId         String    @map("user_id")
  channel        String
  status         String    @default("pending")
  provider       String?
  providerId     String?   @map("provider_id")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("notification_deliveries")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AdminActivityLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  note       String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("admin_activity_logs")
}

model ReportRule {
  id             String           @id @default(uuid())
  targetType     ReportTargetType @map("target_type")
  title          String
  description    String?
  violationScore Int              @default(1) @map("violation_score")
  status         String           @default("active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  reports ContentReport[]

  @@index([targetType, status])
  @@map("report_rules")
}

model ModerationDecision {
  id               String           @id @default(uuid())
  targetType       ReportTargetType @map("target_type")
  targetId         String           @map("target_id")
  decision         String
  action           String
  penaltyScore     Int              @default(0) @map("penalty_score")
  note             String?
  userId           String?          @map("user_id")
  issuedById       String?          @map("issued_by")
  suspensionEndsAt DateTime?        @map("suspension_ends_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  user     User? @relation("ModerationDecisionUser", fields: [userId], references: [id], onDelete: SetNull)
  issuedBy User? @relation("ModerationDecisionActor", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([userId])
  @@map("moderation_decisions")
}

model EmailToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  type       String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("email_tokens")
}

model UserMessage {
  id         String            @id @default(uuid())
  type       UserMessageType
  category   String?
  userId     String?           @map("user_id")
  name       String
  email      String
  phone      String?
  body       String
  status     UserMessageStatus @default(unread)
  appVersion String?           @map("app_version")
  systemInfo String?           @map("system_info")
  readAt     DateTime?         @map("read_at")
  readById   String?           @map("read_by")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  user   User? @relation("UserMessageUser", fields: [userId], references: [id], onDelete: SetNull)
  readBy User? @relation("UserMessageReadBy", fields: [readById], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
  @@index([email])
  @@index([userId])
  @@map("user_messages")
}
