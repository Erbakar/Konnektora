generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  curator
  admin
  super_admin
}

enum UserStatus {
  invited
  pending
  active
  disabled
  frozen
  deleted
  suspended
  banned
}

enum TagStatus {
  active
  hidden
  archived
}

enum EventStatus {
  draft
  published
  cancelled
  archived
}

enum EventFormat {
  online
  offline
  hybrid
}

enum EventVisibility {
  open
  approval_required
  invite_only
}

enum EventParticipantStatus {
  invited
  requested
  accepted
  declined
  banned
  attended
}

enum EventParticipantRole {
  attendee
  organizer
  manager
}

enum PlaceMemberStatus {
  invited
  pending
  accepted
  declined
  banned
}

enum PlaceMemberRole {
  member
  manager
  organizer
}

enum ReportTargetType {
  event
  tag
  user
  media
  place
  username
  website_url
  tag_comment
  event_comment
  place_comment
  comment_reply
  private_message
  post
  post_comment
}

enum PostVisibility {
  everybody
  following
  network
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
  cancelled
}

enum KycStatus {
  not_started
  pending
  approved
  rejected
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
  cancelled
}

enum TicketTypeStatus {
  active
  inactive
  sold_out
}

enum TicketOrderStatus {
  pending
  paid
  cancelled
  refunded
  partially_refunded
}

enum OwnedTicketStatus {
  active
  transferred
  used
  refunded
  cancelled
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum UserMessageType {
  faq
  account_freeze
  write_to_us
}

enum UserMessageStatus {
  unread
  read
}

enum CmsCategoryType {
  faq
  write_to_us
}

enum PrivacyAudience {
  everybody
  following
  network
  nobody
}

enum NotificationTopic {
  tag_request
  private_message
  mention
  comment
  password_changed
  email_changed
  phone_changed
  login
  admin_message
  event_invite
  event_manager
  place_invite
  place_manager
}

enum DeliveryChannel {
  none
  both
  email
  push
}

enum BlockedTargetType {
  user
  tag
  event
  place
}

enum TagSentiment {
  like
  ok
  dislike
}

enum SocialProvider {
  google
  facebook
}

enum ProfileVerificationStatus {
  pending
  approved
  rejected
}

model User {
  id                    String     @id @default(uuid())
  email                 String     @unique
  name                  String
  username              String?    @unique
  passwordHash          String     @map("password_hash")
  role                  UserRole   @default(user)
  adminRoleGroupId      String?    @map("admin_role_group_id")
  status                UserStatus @default(active)
  accountType           String     @default("individual") @map("account_type")
  phone                 String?    @unique
  phoneVerified         Boolean    @default(false) @map("phone_verified")
  country               String?
  city                  String?
  curatorCity           String?    @map("curator_city")
  district              String?
  address               String?
  gender                String?
  birthDate             DateTime?  @map("birth_date")
  website               String?
  companyName           String?    @map("company_name")
  tradeName             String?    @map("trade_name")
  companyType           String?    @map("company_type")
  businessCategory      String?    @map("business_category")
  businessPlan          String     @default("starter") @map("business_plan")
  businessPlanStartedAt DateTime?  @map("business_plan_started_at")
  memberPlan            String     @default("free") @map("member_plan")
  preferredLanguage     String     @default("tr") @map("preferred_language")
  memberPlanStartedAt   DateTime?  @map("member_plan_started_at")
  followerCount         Int        @default(0) @map("follower_count")
  followingCount        Int        @default(0) @map("following_count")
  lastOnlineAt          DateTime?  @map("last_online_at")
  emailVerified         Boolean    @default(false) @map("email_verified")
  invitedById           String?    @map("invited_by")
  penaltyScoreLastYear  Int        @default(0) @map("penalty_score_last_year")
  penaltyScoreAllTime   Int        @default(0) @map("penalty_score_all_time")
  onboardingCompletedAt DateTime?  @map("onboarding_completed_at")
  memberPassVersion     Int        @default(1) @map("member_pass_version")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  adminRoleGroup               AdminRoleGroup?           @relation(fields: [adminRoleGroupId], references: [id], onDelete: SetNull)
  invitedBy                    User?                     @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers                 User[]                    @relation("UserInvites")
  createdTags                  Tag[]                     @relation("TagCreatedBy")
  updatedTags                  Tag[]                     @relation("TagUpdatedBy")
  createdEvents                Event[]                   @relation("EventCreatedBy")
  updatedEvents                Event[]                   @relation("EventUpdatedBy")
  eventParticipations          EventParticipant[]
  eventInvitationsSent         EventInvitation[]         @relation("EventInvitationInviter")
  eventInvitationsReceived     EventInvitation[]         @relation("EventInvitationInvitee")
  ownedGuestLists             GuestList[]                @relation("GuestListOwner")
  guestListMemberships        GuestListMember[]
  guestListShares             GuestListShare[]           @relation("GuestListSharedWith")
  ticketRefunds                TicketRefund[]
  ticketOrders                 EventTicketOrder[]        @relation("TicketBuyer")
  ownedTickets                 OwnedEventTicket[]        @relation("TicketOwner")
  sentTicketTransfers          TicketTransfer[]          @relation("TicketTransferFrom")
  receivedTicketTransfers      TicketTransfer[]          @relation("TicketTransferTo")
  interestTags                 UserInterestTag[]
  profileTagSuggestionsReceived ProfileTagSuggestion[] @relation("ProfileTagSuggestionTarget")
  profileTagSuggestionsSent     ProfileTagSuggestion[] @relation("ProfileTagSuggestionSender")
  submittedReports             ContentReport[]           @relation("ReportSubmittedBy")
  resolvedReports              ContentReport[]           @relation("ReportResolvedBy")
  updatedReportGroupNotes      ReportGroupNote[]
  reportGroupComments          ReportGroupComment[]
  moderationDecisions          ModerationDecision[]      @relation("ModerationDecisionUser")
  issuedModerationDecisions    ModerationDecision[]      @relation("ModerationDecisionActor")
  notifications                Notification[]
  notificationDeliveries       NotificationDelivery[]
  adminActivityLogs            AdminActivityLog[]
  pushSubscriptions            PushSubscription[]
  emailTokens                  EmailToken[]
  phoneVerifications           PhoneVerification[]
  privacySettings              PrivacySettings?
  notificationPreferences      NotificationPreference[]
  contentNotificationSubscriptions ContentNotificationSubscription[]
  blocks                       UserBlock[]
  following                    UserFollow[]              @relation("Following")
  followers                    UserFollow[]              @relation("Followers")
  userMessages                 UserMessage[]             @relation("UserMessageUser")
  readUserMessages             UserMessage[]             @relation("UserMessageReadBy")
  createdPlaces                Place[]                   @relation("PlaceCreatedBy")
  updatedPlaces                Place[]                   @relation("PlaceUpdatedBy")
  placeMemberships             PlaceMember[]
  placeInvitationsSent         PlaceInvitation[]         @relation("PlaceInvitationInviter")
  placeInvitationsReceived     PlaceInvitation[]         @relation("PlaceInvitationInvitee")
  followedPlaces               PlaceFollow[]
  uploadedMedia                MediaFile[]               @relation("MediaUploadedBy")
  authoredComments             ContentComment[]          @relation("CommentAuthor")
  sentPrivateMessages          PrivateMessage[]          @relation("PrivateMessageSender")
  receivedPrivateMessages      PrivateMessage[]          @relation("PrivateMessageRecipient")
  messageReactions             MessageReaction[]
  conversationPreferences      ConversationPreference[]  @relation("ConversationPreferenceOwner")
  billingProfile               BillingProfile?
  financialAccount             FinancialAccount?
  paymentsMade                 PaymentTransaction[]      @relation("PaymentPayer")
  paymentsReceived             PaymentTransaction[]      @relation("PaymentPayee")
  payoutRequests               Payout[]
  corporateKycApplication      CorporateKycApplication?  @relation("CorporateKycApplicant")
  corporateKycReviews          CorporateKycApplication[] @relation("CorporateKycReviewer")
  corporateKycAuditLogs        CorporateKycAuditLog[]
  contentReactions             ContentReaction[]
  contentViews                 ContentView[]
  contentShares                ContentShare[]
  contentActions               ContentAction[]
  scansMade                    MemberScan[]              @relation("MemberScanScanner")
  scansReceived                MemberScan[]              @relation("MemberScanMember")
  socialAccounts               SocialAccount[]
  contactInvites               ContactInvite[]
  profileVerificationRequests  ProfileVerification[]     @relation("ProfileVerificationUser")
  reviewedProfileVerifications ProfileVerification[]     @relation("ProfileVerificationReviewer")
  posts                        Post[]                    @relation("PostAuthor")
  postLikes                    PostLike[]
  postComments                 PostComment[]             @relation("PostCommentAuthor")
  profileVerifiedAt            DateTime?                 @map("profile_verified_at")
  curatorApplications          CuratorApplication[]

  @@index([accountType, status])
  @@index([country, city])
  @@index([lastOnlineAt])
  @@map("users")
}

model CuratorApplication {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  name       String
  email      String
  city       String
  country    String?
  motivation String
  cvUrl      String?  @map("cv_url")
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([city])
  @@map("curator_applications")
}

model AutomatedMessageDelivery {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  messageType String  @map("message_type")
  channel    String
  status     String   @default("sent")
  providerId String?  @map("provider_id")
  sentAt     DateTime @default(now()) @map("sent_at")

  @@unique([userId, targetType, targetId, messageType, channel])
  @@index([status, sentAt])
  @@map("automated_message_deliveries")
}

model Post {
  id           String         @id @default(uuid())
  authorId     String         @map("author_id")
  body         String
  visibility   PostVisibility @default(everybody)
  status       String         @default("active")
  likeCount    Int            @default(0) @map("like_count")
  commentCount Int            @default(0) @map("comment_count")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  author   User          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  likes    PostLike[]
  comments PostComment[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  url       String
  type      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("post_media")
}

model PostLike {
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id")
  body      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("PostCommentReplies")

  @@index([postId, status, createdAt])
  @@index([authorId, createdAt])
  @@map("post_comments")
}

model ProfileVerification {
  id               String                    @id @default(uuid())
  userId           String                    @map("user_id")
  referenceMediaId String                    @map("reference_media_id")
  selfieUrl        String                    @map("selfie_url")
  challenge        String
  status           ProfileVerificationStatus @default(pending)
  provider         String                    @default("manual")
  faceMatchScore   Float?                    @map("face_match_score")
  livenessScore    Float?                    @map("liveness_score")
  decisionReason   String?                   @map("decision_reason")
  reviewedById     String?                   @map("reviewed_by_id")
  reviewedAt       DateTime?                 @map("reviewed_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  user       User  @relation("ProfileVerificationUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ProfileVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("profile_verifications")
}

model SocialAccount {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  provider       SocialProvider
  providerUserId String         @map("provider_user_id")
  email          String?
  displayName    String?        @map("display_name")
  avatarUrl      String?        @map("avatar_url")
  connectedAt    DateTime       @default(now()) @map("connected_at")
  lastUsedAt     DateTime       @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("social_accounts")
}

model ContactInvite {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  channel       String
  recipientHash String   @map("recipient_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("contact_invites")
}

model MemberScan {
  id        String   @id @default(uuid())
  scannerId String   @map("scanner_id")
  memberId  String   @map("member_id")
  method    String   @default("qr")
  createdAt DateTime @default(now()) @map("created_at")

  scanner User @relation("MemberScanScanner", fields: [scannerId], references: [id], onDelete: Cascade)
  member  User @relation("MemberScanMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([scannerId, createdAt])
  @@index([memberId, createdAt])
  @@map("member_scans")
}

model UserFollow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

model UserBlock {
  userId     String            @map("user_id")
  targetType BlockedTargetType @map("target_type")
  targetId   String            @map("target_id")
  createdAt  DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("user_blocks")
}

model NotificationPreference {
  userId    String            @map("user_id")
  topic     NotificationTopic
  channel   DeliveryChannel
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topic])
  @@map("notification_preferences")
}

model ContentNotificationSubscription {
  userId     String   @map("user_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId, enabled])
  @@map("content_notification_subscriptions")
}

model PrivacySettings {
  userId                String          @id @map("user_id")
  messageAudience       PrivacyAudience @default(everybody) @map("message_audience")
  directoryDiscoverable Boolean         @default(true) @map("directory_discoverable")
  eventAudience         PrivacyAudience @default(everybody) @map("event_audience")
  eventInviteAudience   PrivacyAudience @default(everybody) @map("event_invite_audience")
  placeAudience         PrivacyAudience @default(everybody) @map("place_audience")
  placeInviteAudience   PrivacyAudience @default(everybody) @map("place_invite_audience")
  profileNameAudience   PrivacyAudience @default(everybody) @map("profile_name_audience")
  demographicsAudience  PrivacyAudience @default(everybody) @map("demographics_audience")
  locationAudience      PrivacyAudience @default(everybody) @map("location_audience")
  websiteAudience       PrivacyAudience @default(everybody) @map("website_audience")
  businessAudience      PrivacyAudience @default(everybody) @map("business_audience")
  addressAudience       PrivacyAudience @default(everybody) @map("address_audience")
  tradeNameAudience     PrivacyAudience @default(everybody) @map("trade_name_audience")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model PhoneVerification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phone, createdAt])
  @@index([expiresAt])
  @@map("phone_verifications")
}

model AdminRoleGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  permissions String[] @default([])
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("admin_role_groups")
}

model CmsCategory {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String?
  type        CmsCategoryType @default(faq)
  status      String          @default("active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  faqs Faq[]

  @@index([status])
  @@index([type, status])
  @@map("cms_categories")
}

model Faq {
  id         String   @id @default(uuid())
  categoryId String   @map("category_id")
  title      String
  body       String
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category CmsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, status])
  @@map("faqs")
}

model Announcement {
  id                  String    @id @default(uuid())
  title               String
  body                String
  titleEn             String?   @map("title_en")
  bodyEn              String?   @map("body_en")
  target              String    @default("all")
  targetLastLoginFrom DateTime? @map("target_last_login_from")
  targetLastLoginTo   DateTime? @map("target_last_login_to")
  targetJoinedFrom    DateTime? @map("target_joined_from")
  targetJoinedTo      DateTime? @map("target_joined_to")
  targetAppVersion    String?   @map("target_app_version")
  publishMode         String    @default("scheduled") @map("publish_mode")
  status              String    @default("active")
  publishAt           DateTime  @default(now()) @map("publish_at")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([status, publishAt])
  @@map("announcements")
}

model CmsPolicy {
  id          String    @id @default(uuid())
  type        String    @unique
  title       String
  body        String
  status      String    @default("active")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("cms_policies")
}

model TagCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tags Tag[]

  @@map("tag_categories")
}

model Tag {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  status      TagStatus @default(active)
  usageCount  Int       @default(0) @map("usage_count")
  categoryId  String?   @map("category_id")
  createdById String?   @map("created_by")
  updatedById String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category        TagCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("TagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?             @relation("TagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  events          EventTag[]
  places          PlaceTag[]
  interestedUsers UserInterestTag[]
  profileSuggestions ProfileTagSuggestion[]

  @@index([status])
  @@map("tags")
}

model Event {
  id                      String          @id @default(uuid())
  title                   String
  slug                    String          @unique
  legacySlugs             String[]        @default([]) @map("legacy_slugs")
  summary                 String
  description             String
  status                  EventStatus     @default(published)
  startsAt                DateTime        @map("starts_at")
  endsAt                  DateTime?       @map("ends_at")
  timezone                String
  format                  EventFormat
  visibility              EventVisibility @default(open)
  placeId                 String?         @map("place_id")
  locationName            String?         @map("location_name")
  locationAddress         String?         @map("location_address")
  city                    String?
  country                 String?
  latitude                Decimal?        @db.Decimal(10, 7)
  longitude               Decimal?        @db.Decimal(10, 7)
  language                String
  organizerName           String?         @map("organizer_name")
  externalRegistrationUrl String?         @map("external_registration_url")
  liveUrl                 String?         @map("live_url")
  timeline                String?         @map("event_timeline")
  lineup                  Json?           @map("lineup")
  ticketTypes             Json?           @map("ticket_types")
  coverImageUrl           String?         @map("cover_image_url")
  capacity                Int?
  price                   Decimal         @default(0) @db.Decimal(10, 2)
  currency                String          @default("TRY")
  createdById             String?         @map("created_by")
  updatedById             String?         @map("updated_by")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  createdBy         User?                @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?                @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  place             Place?               @relation(fields: [placeId], references: [id], onDelete: SetNull)
  tags              EventTag[]
  participants      EventParticipant[]
  invitations       EventInvitation[]
  media             EventMedia[]
  ticketRefunds     TicketRefund[]
  payments          PaymentTransaction[]
  ticketTypeRecords EventTicketType[]
  ticketOrders      EventTicketOrder[]
  ownedTickets      OwnedEventTicket[]

  @@index([status, startsAt])
  @@index([placeId, startsAt])
  @@map("events")
}

model EventTicketType {
  id           String             @id @default(uuid())
  eventId      String             @map("event_id")
  name         String
  description  String?
  capacity     Int
  perUserLimit Int?               @map("per_user_limit")
