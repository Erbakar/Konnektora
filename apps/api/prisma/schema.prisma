generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
  super_admin
}

enum UserStatus {
  invited
  pending
  active
  disabled
  frozen
  deleted
  suspended
  banned
}

enum TagStatus {
  active
  hidden
  archived
}

enum EventStatus {
  draft
  published
  cancelled
  archived
}

enum EventFormat {
  online
  offline
  hybrid
}

enum EventVisibility {
  open
  approval_required
  invite_only
}

enum EventParticipantStatus {
  invited
  requested
  accepted
  declined
  banned
  attended
}

enum EventParticipantRole {
  attendee
  organizer
  manager
}

enum PlaceMemberStatus {
  invited
  accepted
  declined
  banned
}

enum PlaceMemberRole {
  member
  manager
  organizer
}

enum ReportTargetType {
  event
  tag
  user
  media
  place
  username
  website_url
  tag_comment
  event_comment
  place_comment
  comment_reply
  private_message
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum UserMessageType {
  faq
  account_freeze
  write_to_us
}

enum UserMessageStatus {
  unread
  read
}

enum CmsCategoryType {
  faq
  write_to_us
}

enum PrivacyAudience {
  everybody
  following
  network
}

enum NotificationTopic {
  tag_request
  private_message
  mention
  comment
  password_changed
  email_changed
  phone_changed
  login
  admin_message
  event_invite
  event_manager
  place_invite
  place_manager
}

enum DeliveryChannel {
  none
  both
  email
  push
}

enum BlockedTargetType {
  user
  tag
  event
  place
}

enum TagSentiment {
  like
  ok
  dislike
}

enum SocialProvider {
  google
  facebook
}

enum ProfileVerificationStatus {
  pending
  approved
  rejected
}

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  name                 String
  username             String?    @unique
  passwordHash         String     @map("password_hash")
  role                 UserRole   @default(user)
  adminRoleGroupId     String?    @map("admin_role_group_id")
  status               UserStatus @default(active)
  accountType          String     @default("individual") @map("account_type")
  phone                String?    @unique
  phoneVerified        Boolean    @default(false) @map("phone_verified")
  country              String?
  city                 String?
  district             String?
  address              String?
  gender               String?
  birthDate            DateTime?  @map("birth_date")
  website              String?
  companyName          String?    @map("company_name")
  tradeName            String?    @map("trade_name")
  companyType          String?    @map("company_type")
  businessCategory     String?    @map("business_category")
  followerCount        Int        @default(0) @map("follower_count")
  followingCount       Int        @default(0) @map("following_count")
  lastOnlineAt         DateTime?  @map("last_online_at")
  emailVerified        Boolean    @default(false) @map("email_verified")
  invitedById          String?    @map("invited_by")
  penaltyScoreLastYear Int        @default(0) @map("penalty_score_last_year")
  penaltyScoreAllTime  Int        @default(0) @map("penalty_score_all_time")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  memberPassVersion    Int        @default(1) @map("member_pass_version")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  adminRoleGroup            AdminRoleGroup?      @relation(fields: [adminRoleGroupId], references: [id], onDelete: SetNull)
  invitedBy                 User?                @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers              User[]               @relation("UserInvites")
  createdTags               Tag[]                @relation("TagCreatedBy")
  updatedTags               Tag[]                @relation("TagUpdatedBy")
  createdEvents             Event[]              @relation("EventCreatedBy")
  updatedEvents             Event[]              @relation("EventUpdatedBy")
  eventParticipations       EventParticipant[]
  ticketRefunds             TicketRefund[]
  interestTags              UserInterestTag[]
  submittedReports          ContentReport[]      @relation("ReportSubmittedBy")
  resolvedReports           ContentReport[]      @relation("ReportResolvedBy")
  updatedReportGroupNotes   ReportGroupNote[]
  reportGroupComments       ReportGroupComment[]
  moderationDecisions       ModerationDecision[] @relation("ModerationDecisionUser")
  issuedModerationDecisions ModerationDecision[] @relation("ModerationDecisionActor")
  notifications             Notification[]
  adminActivityLogs         AdminActivityLog[]
  emailTokens               EmailToken[]
  phoneVerifications        PhoneVerification[]
  privacySettings           PrivacySettings?
  notificationPreferences  NotificationPreference[]
  blocks                   UserBlock[]
  following                UserFollow[] @relation("Following")
  followers                UserFollow[] @relation("Followers")
  userMessages              UserMessage[]        @relation("UserMessageUser")
  readUserMessages          UserMessage[]        @relation("UserMessageReadBy")
  createdPlaces             Place[]              @relation("PlaceCreatedBy")
  updatedPlaces             Place[]              @relation("PlaceUpdatedBy")
  placeMemberships          PlaceMember[]
  followedPlaces            PlaceFollow[]
  uploadedMedia             MediaFile[]          @relation("MediaUploadedBy")
  authoredComments          ContentComment[]     @relation("CommentAuthor")
  sentPrivateMessages       PrivateMessage[]     @relation("PrivateMessageSender")
  receivedPrivateMessages   PrivateMessage[]     @relation("PrivateMessageRecipient")
  contentReactions          ContentReaction[]
  contentViews              ContentView[]
  scansMade                 MemberScan[] @relation("MemberScanScanner")
  scansReceived             MemberScan[] @relation("MemberScanMember")
  socialAccounts           SocialAccount[]
  contactInvites           ContactInvite[]
  profileVerificationRequests ProfileVerification[] @relation("ProfileVerificationUser")
  reviewedProfileVerifications ProfileVerification[] @relation("ProfileVerificationReviewer")
  profileVerifiedAt       DateTime? @map("profile_verified_at")

  @@index([accountType, status])
  @@index([country, city])
  @@index([lastOnlineAt])
  @@map("users")
}

model ProfileVerification {
  id                String                    @id @default(uuid())
  userId            String                    @map("user_id")
  referenceMediaId  String                    @map("reference_media_id")
  selfieUrl         String                    @map("selfie_url")
  challenge         String
  status            ProfileVerificationStatus @default(pending)
  provider          String                    @default("manual")
  faceMatchScore    Float?                    @map("face_match_score")
  livenessScore     Float?                    @map("liveness_score")
  decisionReason    String?                   @map("decision_reason")
  reviewedById      String?                   @map("reviewed_by_id")
  reviewedAt        DateTime?                 @map("reviewed_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  user       User  @relation("ProfileVerificationUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ProfileVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("profile_verifications")
}

model SocialAccount {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  provider        SocialProvider
  providerUserId  String         @map("provider_user_id")
  email           String?
  displayName     String?        @map("display_name")
  avatarUrl       String?        @map("avatar_url")
  connectedAt     DateTime       @default(now()) @map("connected_at")
  lastUsedAt      DateTime       @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("social_accounts")
}

model ContactInvite {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  channel        String
  recipientHash  String   @map("recipient_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("contact_invites")
}

model MemberScan {
  id        String   @id @default(uuid())
  scannerId String   @map("scanner_id")
  memberId  String   @map("member_id")
  method    String   @default("qr")
  createdAt DateTime @default(now()) @map("created_at")

  scanner User @relation("MemberScanScanner", fields: [scannerId], references: [id], onDelete: Cascade)
  member  User @relation("MemberScanMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([scannerId, createdAt])
  @@index([memberId, createdAt])
  @@map("member_scans")
}

model UserFollow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

model UserBlock {
  userId     String            @map("user_id")
  targetType BlockedTargetType @map("target_type")
  targetId   String            @map("target_id")
  createdAt  DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("user_blocks")
}

model NotificationPreference {
  userId    String            @map("user_id")
  topic     NotificationTopic
  channel   DeliveryChannel
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topic])
  @@map("notification_preferences")
}

model PrivacySettings {
  userId                 String          @id @map("user_id")
  messageAudience        PrivacyAudience @default(everybody) @map("message_audience")
  directoryDiscoverable  Boolean         @default(false) @map("directory_discoverable")
  eventAudience          PrivacyAudience @default(everybody) @map("event_audience")
  eventInviteAudience    PrivacyAudience @default(everybody) @map("event_invite_audience")
  placeAudience          PrivacyAudience @default(everybody) @map("place_audience")
  placeInviteAudience    PrivacyAudience @default(everybody) @map("place_invite_audience")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model PhoneVerification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phone, createdAt])
  @@index([expiresAt])
  @@map("phone_verifications")
}

model AdminRoleGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  permissions String[] @default([])
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("admin_role_groups")
}

model CmsCategory {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String?
  type        CmsCategoryType @default(faq)
  status      String          @default("active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  faqs Faq[]

  @@index([status])
  @@index([type, status])
  @@map("cms_categories")
}

model Faq {
  id         String   @id @default(uuid())
  categoryId String   @map("category_id")
  title      String
  body       String
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category CmsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, status])
  @@map("faqs")
}

model Announcement {
  id                  String    @id @default(uuid())
  title               String
  body                String
  target              String    @default("all")
  targetLastLoginFrom DateTime? @map("target_last_login_from")
  targetLastLoginTo   DateTime? @map("target_last_login_to")
  targetJoinedFrom    DateTime? @map("target_joined_from")
  targetJoinedTo      DateTime? @map("target_joined_to")
  targetAppVersion    String?   @map("target_app_version")
  publishMode         String    @default("scheduled") @map("publish_mode")
  status              String    @default("active")
  publishAt           DateTime  @default(now()) @map("publish_at")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([status, publishAt])
  @@map("announcements")
}

model CmsPolicy {
  id          String    @id @default(uuid())
  type        String    @unique
  title       String
  body        String
  status      String    @default("active")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("cms_policies")
}

model TagCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tags Tag[]

  @@map("tag_categories")
}

model Tag {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  status      TagStatus @default(active)
  usageCount  Int       @default(0) @map("usage_count")
  categoryId  String?   @map("category_id")
  createdById String?   @map("created_by")
  updatedById String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category        TagCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("TagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?             @relation("TagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  events          EventTag[]
  interestedUsers UserInterestTag[]

  @@index([status])
  @@map("tags")
}

model Event {
  id                      String          @id @default(uuid())
  title                   String
  slug                    String          @unique
  summary                 String
  description             String
  status                  EventStatus     @default(published)
  startsAt                DateTime        @map("starts_at")
  endsAt                  DateTime?       @map("ends_at")
  timezone                String
  format                  EventFormat
  visibility              EventVisibility @default(open)
  locationName            String?         @map("location_name")
  locationAddress         String?         @map("location_address")
  city                    String?
  country                 String?
  latitude                Decimal?        @db.Decimal(10, 7)
  longitude               Decimal?        @db.Decimal(10, 7)
  language                String
  organizerName           String?         @map("organizer_name")
  externalRegistrationUrl String?         @map("external_registration_url")
  coverImageUrl           String?         @map("cover_image_url")
  capacity                Int?
  createdById             String?         @map("created_by")
  updatedById             String?         @map("updated_by")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  createdBy     User?              @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?              @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  tags          EventTag[]
  participants  EventParticipant[]
  media         EventMedia[]
  ticketRefunds TicketRefund[]

  @@index([status, startsAt])
  @@map("events")
}

model EventParticipant {
  id          String                 @id @default(uuid())
  eventId     String                 @map("event_id")
  userId      String                 @map("user_id")
  status      EventParticipantStatus @default(requested)
  role        EventParticipantRole   @default(attendee)
  checkedInAt DateTime?              @map("checked_in_at")
  checkInTokenHash String?           @unique @map("check_in_token_hash")
  checkInTokenIssuedAt DateTime?     @map("check_in_token_issued_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@map("event_participants")
}

model TicketRefund {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  amount    Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("TRY")
  provider  String   @default("simulated")
  status    String   @default("simulated_refunded")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([userId, createdAt])
  @@map("ticket_refunds")
}

model EventMedia {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  url       String
  type      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_media")
}

model Place {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  status        String   @default("active")
  coverImageUrl String?  @map("cover_image_url")
  country       String?
  city          String?
  address       String?
  followerCount Int      @default(0) @map("follower_count")
  inviteCount   Int      @default(0) @map("invite_count")
  createdById   String?  @map("created_by")
  updatedById   String?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("PlaceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PlaceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  members   PlaceMember[]
  followers PlaceFollow[]

  @@index([status, createdAt])
  @@index([country, city])
  @@map("places")
}

model PlaceMember {
  placeId  String            @map("place_id")
  userId   String            @map("user_id")
  status   PlaceMemberStatus @default(invited)
  role     PlaceMemberRole   @default(member)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([placeId, userId])
  @@index([userId, status])
  @@index([placeId, role, status])
  @@map("place_members")
}

model PlaceFollow {
  placeId   String   @map("place_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([placeId, userId])
  @@index([userId, createdAt])
  @@map("place_follows")
}

model MediaFile {
  id           String           @id @default(uuid())
  url          String
  type         String           @default("image")
  status       String           @default("active")
  contentType  ReportTargetType @map("content_type")
  contentId    String           @map("content_id")
  uploadedById String?          @map("uploaded_by")
  sortOrder    Int              @default(0) @map("sort_order")
  isProfilePicture Boolean      @default(false) @map("is_profile_picture")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  uploadedBy User? @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([contentType, contentId])
  @@index([uploadedById, contentType, contentId, sortOrder])
  @@index([status, createdAt])
  @@map("media_files")
}

model ContentComment {
  id         String           @id @default(uuid())
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id")
  parentId   String?          @map("parent_id")
  authorId   String?          @map("author_id")
  body       String
  status     String           @default("active")
  likeCount  Int              @default(0) @map("like_count")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  parent  ContentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ContentComment[] @relation("CommentReplies")
  author  User?            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([parentId])
  @@index([status, createdAt])
  @@map("content_comments")
}

model PrivateMessage {
  id          String   @id @default(uuid())
  senderId    String?  @map("sender_id")
  recipientId String?  @map("recipient_id")
  body        String
  status      String   @default("active")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sender    User? @relation("PrivateMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User? @relation("PrivateMessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([senderId, recipientId])
  @@index([recipientId, readAt, createdAt])
  @@index([status, createdAt])
  @@map("private_messages")
}

model ContentReaction {
  id         String           @id @default(uuid())
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id")
  userId     String           @map("user_id")
  reaction   String
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId, reaction])
  @@index([targetType, targetId])
  @@map("content_reactions")
}

model ContentView {
  id         String           @id @default(uuid())
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id")
  userId     String?          @map("user_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([userId])
  @@map("content_views")
}

model EventTag {
  eventId String @map("event_id")
  tagId   String @map("tag_id")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@map("event_tags")
}

model UserInterestTag {
  userId    String       @map("user_id")
  tagId     String       @map("tag_id")
  sentiment TagSentiment @default(like)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
  @@map("user_interest_tags")
}

model ContentReport {
  id             String           @id @default(uuid())
  targetType     ReportTargetType @map("target_type")
  targetId       String           @map("target_id")
  ruleId         String?          @map("rule_id")
  reason         String
  details        String?
  status         ReportStatus     @default(open)
  resolutionNote String?          @map("resolution_note")
  reporterId     String           @map("reporter_id")
  resolvedById   String?          @map("resolved_by")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  reporter   User        @relation("ReportSubmittedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?       @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  rule       ReportRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([ruleId])
  @@map("content_reports")
}

model ReportGroupNote {
  id          String           @id @default(uuid())
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id")
  note        String
  updatedById String?          @map("updated_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([targetType, targetId])
  @@map("report_group_notes")
}

model ReportGroupComment {
  id          String           @id @default(uuid())
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id")
  body        String
  createdById String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@map("report_group_comments")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  type       String
  title      String
  body       String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AdminActivityLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  note       String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("admin_activity_logs")
}

model ReportRule {
  id             String           @id @default(uuid())
  targetType     ReportTargetType @map("target_type")
  title          String
  description    String?
  violationScore Int              @default(1) @map("violation_score")
  status         String           @default("active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  reports ContentReport[]

  @@index([targetType, status])
  @@map("report_rules")
}

model ModerationDecision {
  id               String           @id @default(uuid())
  targetType       ReportTargetType @map("target_type")
  targetId         String           @map("target_id")
  decision         String
  action           String
  penaltyScore     Int              @default(0) @map("penalty_score")
  note             String?
  userId           String?          @map("user_id")
  issuedById       String?          @map("issued_by")
  suspensionEndsAt DateTime?        @map("suspension_ends_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  user     User? @relation("ModerationDecisionUser", fields: [userId], references: [id], onDelete: SetNull)
  issuedBy User? @relation("ModerationDecisionActor", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([userId])
  @@map("moderation_decisions")
}

model EmailToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  type       String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("email_tokens")
}

model UserMessage {
  id         String            @id @default(uuid())
  type       UserMessageType
  category   String?
  userId     String?           @map("user_id")
  name       String
  email      String
  phone      String?
  body       String
  status     UserMessageStatus @default(unread)
  appVersion String?           @map("app_version")
  systemInfo String?           @map("system_info")
  readAt     DateTime?         @map("read_at")
  readById   String?           @map("read_by")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  user   User? @relation("UserMessageUser", fields: [userId], references: [id], onDelete: SetNull)
  readBy User? @relation("UserMessageReadBy", fields: [readById], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
  @@index([email])
  @@index([userId])
  @@map("user_messages")
}
